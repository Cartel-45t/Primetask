NODE_ENV=development
PORT=5001

# Configure your MongoDB connection before starting the server.
MONGODB_URI=

# Replace with a cryptographically random secret.
JWT_SECRET=

# Use your actual frontend origin in production.
FRONTEND_ORIGIN=http://127.0.0.1:8080

# Public application URLs
PUBLIC_SITE_URL=https://pages-nine-brown.vercel.app

# Safaricom Daraja: keep live payments disabled until reconciliation is ready
DARAJA_ENV=sandbox
DARAJA_LIVE_ENABLED=false
DARAJA_CALLBACK_URL=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# Cloudinary: optional unless an enabled feature requires uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Wallet limits: amounts are KSh only for M-Pesa top-ups;
# withdrawal limits are USD cents
WALLET_TOPUP_MIN_KES=
WALLET_TOPUP_MAX_KES=
WALLET_WITHDRAWAL_MIN_USD_CENTS=
WALLET_WITHDRAWAL_MAX_USD_CENTS=
